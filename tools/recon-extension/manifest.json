{
  "manifest_version": 3,
  "name": "YNAB Amazon Helper - RECON (dev only)",
  "version": "0.0.4",
  "description": "Dev-only: dumps Amazon/YNAB page structure to a local server on 127.0.0.1:8765.",
  "host_permissions": [
    "https://www.amazon.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/cpe/yourpayments/transactions*"
      ],
      "js": [
        "amazon-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.amazon.com/cpe/yourpayments/transactions*"
      ],
      "js": [
        "amazon-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}