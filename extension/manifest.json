{
  "manifest_version": 3,
  "name": "YNAB Helpers",
  "version": "0.2.0",
  "description": "Fills empty YNAB memos for Amazon and Venmo transactions (items, people, notes, links), using your own sessions.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/cpe/yourpayments/transactions*"
      ],
      "js": [
        "shared.js",
        "amazon-parse.js",
        "amazon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://account.venmo.com/*"
      ],
      "js": [
        "venmo-shared.js",
        "venmo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.ynab.com/*"
      ],
      "js": [
        "guard.js",
        "ynab-bridge.js",
        "amazon-ynab-main.js",
        "venmo-ynab-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.ynab.com/*"
      ],
      "js": [
        "shared.js",
        "venmo-shared.js",
        "ynab-helper.js",
        "amazon-ynab.js",
        "venmo-ynab.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
